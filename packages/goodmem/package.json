{
  "name": "@voltagent/goodmem",
  "description": "GoodMem integration for VoltAgent - memory layer for AI agents with semantic storage, retrieval, and summarization",
  "version": "0.1.0",
  "dependencies": {
    "@voltagent/internal": "^1.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@voltagent/core": "^2.3.7"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "peerDependencies": {
    "@voltagent/core": "^2.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VoltAgent/voltagent.git",
    "directory": "packages/goodmem"
  },
  "scripts": {
    "attw": "attw --pack",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "publint": "publint --strict",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:setup": "bash e2e/scripts/setup-goodmem.sh",
    "e2e:run": "vitest run --config e2e/vitest.config.mts",
    "e2e:teardown": "bash e2e/scripts/teardown-goodmem.sh",
    "e2e": "npm run e2e:setup && npm run e2e:run; status=$?; npm run e2e:teardown; exit $status"
  },
  "types": "dist/index.d.ts"
}
